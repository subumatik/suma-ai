generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                      String    @id @db.Uuid
  full_name               String?
  email                   String?
  phone                   String?
  role                    String    @default("client")
  baro_number             String?
  specialization          String?
  referans_kodu           String?   @unique
  email_verified          Boolean   @default(false)
  verification_otp        String?
  verification_otp_expires DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  dosyaLawyers       DosyaLawyer[]
  dosyaClients       DosyaClient[]
  uploadedDocs       DosyaDocument[]
  statusUpdates      DosyaStatusUpdate[]
  lawyerAppointments Appointment[] @relation("LawyerAppointments")
  clientAppointments Appointment[] @relation("ClientAppointments")
  sentMessages       Message[] @relation("SentMessages")
  receivedMessages   Message[] @relation("ReceivedMessages")
  notifications      Notification[]
  auditLogs          AuditLog[]
  categories         Category[]
  statuses           Status[]
  lawyerAConnections LawyerConnection[] @relation("LawyerAConnections")
  lawyerBConnections LawyerConnection[] @relation("LawyerBConnections")

  @@map("profiles")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  color       String   @default("#3B82F6")
  icon        String   @default("Folder")
  created_by  String?  @db.Uuid
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  creator     Profile? @relation(fields: [created_by], references: [id], onDelete: SetNull)
  dosyalar    Dosya[]

  @@map("categories")
}

model Status {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  color       String   @default("#3B82F6")
  order       Int      @default(0)
  is_default  Boolean  @default(false)
  created_by  String?  @db.Uuid
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  creator     Profile? @relation(fields: [created_by], references: [id], onDelete: SetNull)
  dosyalar    Dosya[]
  statusUpdates DosyaStatusUpdate[]

  @@map("statuses")
}

model Dosya {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  file_number    String?
  category_id    String?  @db.Uuid
  status_id      String   @db.Uuid
  court_name     String?
  court_file_no  String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  category       Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  status         Status   @relation(fields: [status_id], references: [id])
  lawyers        DosyaLawyer[]
  clients        DosyaClient[]
  documents      DosyaDocument[]
  statusUpdates  DosyaStatusUpdate[]
  messages       Message[]
  chunks         DocumentChunk[]
  hearings       Hearing[]
  appointments   Appointment[]

  @@map("dosyalar")
}

model DosyaLawyer {
  id        String @id @default(uuid()) @db.Uuid
  dosya_id  String @db.Uuid
  lawyer_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  dosya     Dosya   @relation(fields: [dosya_id], references: [id], onDelete: Cascade)
  lawyer    Profile @relation(fields: [lawyer_id], references: [id], onDelete: Cascade)

  @@unique([dosya_id, lawyer_id])
  @@index([lawyer_id])
  @@map("dosya_lawyers")
}

model DosyaClient {
  id        String @id @default(uuid()) @db.Uuid
  dosya_id  String @db.Uuid
  client_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  dosya     Dosya   @relation(fields: [dosya_id], references: [id], onDelete: Cascade)
  client    Profile @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([dosya_id, client_id])
  @@index([client_id])
  @@map("dosya_clients")
}

model DosyaDocument {
  id             String           @id @default(uuid()) @db.Uuid
  dosya_id       String           @db.Uuid
  file_name      String
  file_url       String
  file_type      String?
  file_size      Int?
  uploaded_by    String           @db.Uuid
  description    String?
  claude_file_id String?
  created_at     DateTime         @default(now()) @db.Timestamptz(6)

  dosya       Dosya            @relation(fields: [dosya_id], references: [id], onDelete: Cascade)
  uploader    Profile          @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]

  @@map("dosya_documents")
}

model DocumentChunk {
  id                String   @id @default(uuid()) @db.Uuid
  dosya_document_id String   @db.Uuid
  case_id           String   @db.Uuid
  content           String
  embedding         Unsupported("vector(384)")?
  metadata          Json?    @db.JsonB
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  document DosyaDocument @relation(fields: [dosya_document_id], references: [id], onDelete: Cascade)
  dosya    Dosya         @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
  @@map("document_chunks")
}

model DosyaStatusUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  dosya_id    String   @db.Uuid
  status_id   String   @db.Uuid
  description String?
  updated_by  String   @db.Uuid
  hearing_date DateTime? @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  dosya       Dosya    @relation(fields: [dosya_id], references: [id], onDelete: Cascade)
  status      Status   @relation(fields: [status_id], references: [id])
  updater     Profile  @relation(fields: [updated_by], references: [id], onDelete: Cascade)

  @@map("dosya_status_updates")
}

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  lawyer_id        String            @db.Uuid
  client_id        String            @db.Uuid
  dosya_id         String?           @db.Uuid
  appointment_date DateTime          @db.Timestamptz(6)
  duration_minutes Int               @default(60)
  status           AppointmentStatus @default(REQUESTED)
  topic            String?
  notes            String?
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  lawyer           Profile           @relation("LawyerAppointments", fields: [lawyer_id], references: [id], onDelete: Cascade)
  client           Profile           @relation("ClientAppointments", fields: [client_id], references: [id], onDelete: Cascade)
  dosya            Dosya?            @relation(fields: [dosya_id], references: [id], onDelete: SetNull)

  @@map("appointments")
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("appointment_status")
}

model Message {
  id                 String    @id @default(uuid()) @db.Uuid
  sender_id          String    @db.Uuid
  receiver_id        String    @db.Uuid
  dosya_id           String?   @db.Uuid
  content            String
  is_read            Boolean   @default(false)
  is_deleted_for_all Boolean   @default(false)
  deleted_by_sender  Boolean   @default(false)
  deleted_by_receiver Boolean  @default(false)
  edited_at          DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  sender      Profile  @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver    Profile  @relation("ReceivedMessages", fields: [receiver_id], references: [id], onDelete: Cascade)
  dosya       Dosya?   @relation(fields: [dosya_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  type        String
  title       String
  message     String?
  related_id  String?  @db.Uuid
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user        Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Hearing {
  id                    String   @id @default(uuid()) @db.Uuid
  dosya_id              String   @db.Uuid
  hearing_date          DateTime @db.Timestamptz(6)
  court_name            String?
  description           String?
  reminder_days_before  Int?
  reminder_email_sent   Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  dosya   Dosya   @relation(fields: [dosya_id], references: [id], onDelete: Cascade)

  @@map("hearings")
}

model LawyerConnection {
  id          String   @id @default(uuid()) @db.Uuid
  lawyer_a_id String   @db.Uuid
  lawyer_b_id String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  lawyerA Profile @relation("LawyerAConnections", fields: [lawyer_a_id], references: [id], onDelete: Cascade)
  lawyerB Profile @relation("LawyerBConnections", fields: [lawyer_b_id], references: [id], onDelete: Cascade)

  @@unique([lawyer_a_id, lawyer_b_id])
  @@map("lawyer_connections")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  table_name  String
  record_id   String?
  old_data    Json?
  new_data    Json?
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
