# Supabase (gerekli)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Uygulama domaini — custom domain kullanıyorsan Vercel'e ekle
# Boş bırakılırsa Vercel otomatik VERCEL_URL kullanır
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Supabase Service Role Key (OG image bot'ları için case detay verisi çekmek istersen)
# RLS bypass eder, sadece server-side kullanılır, client'a asla exposed etme
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
